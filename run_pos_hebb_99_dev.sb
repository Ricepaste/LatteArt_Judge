#!/bin/bash
#SBATCH --job-name=pos_hebb_99_dev ## Job 名稱
#SBATCH --nodes=1                  ## 索取 1 個節點
#SBATCH --cpus-per-task=12         ## 每個 task 索取 12 顆 CPU
#SBATCH --gres=gpu:1               ## 每個節點索取 1 張 H200/H100 GPU
#SBATCH --account="MST113277"      ## iService_ID 計畫 ID
#SBATCH --partition=dev            ## 使用 dev queue (快速熱測試)
#SBATCH --output=logs/%x-%j-%N.out
#SBATCH --error=logs/%x-%j-%N.err

# 清理並加載環境
module purge
module load singularity

SIF="/home/sharpaste236/sparse_ssl_image.sif"
SINGULARITY="singularity run --nv $SIF"

export SINGULARITY_BINDPATH="/work:/work,/home:/home"
export TARGET_SPARSITY=0.99
# 開發模式：將 Epoch 縮短到 2，確認能正常跑到 Linear probing 階段
export NUM_EPOCHS=2
export TARGET_DATASET="cifar100"
export DATALOADER_WORKERS=10

# 確保日誌目錄存在
mkdir -p logs

# 我們切換到專案根目錄
WORKDIR="/home/sharpaste236/LatteArt_Judge"

# 開發測試模式：使用單一純隨機的種子碼
export RUN_SEED=$RANDOM
echo "============================================================"
echo "🧪 DEV TEST: Positive Hebbian Ablation (Sparsity=$TARGET_SPARSITY, Seed=$RUN_SEED, Epochs=$NUM_EPOCHS)"
echo "============================================================"

# 透過 Singularity 執行現有的正赫布消融腳本
srun $SINGULARITY bash -c "cd $WORKDIR && export PYTHONPATH=\"$WORKDIR:\$PYTHONPATH\" && python main/run_positive_hebb_ablation.py"

echo "✅ DEV Test completed!"
